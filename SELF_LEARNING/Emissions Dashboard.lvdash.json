{
  "datasets": [
    {
      "name": "7c22c4b6",
      "displayName": "Location Data",
      "queryLines": [
        "select latitude,longitude,`GHG emissions mtons CO2e` as Emissions from \r\n",
        "emissions.default.emissions_data"
      ]
    },
    {
      "name": "1ff84155",
      "displayName": "Emissions per person",
      "queryLines": [
        "select county_name, population,\r\n",
        "       try_cast(replace(`GHG emissions mtons CO2e`, ',', '') as double) / try_cast(population as double) as Emissions_per_person\r\n",
        "from emissions.default.emissions_data\r\n",
        "order by emissions_per_person desc "
      ]
    }
  ],
  "pages": [
    {
      "name": "e349204b",
      "displayName": "Untitled page",
      "layout": [
        {
          "widget": {
            "name": "emissions-per-locations",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "7c22c4b6",
                  "fields": [
                    {
                      "name": "latitude",
                      "expression": "`latitude`"
                    },
                    {
                      "name": "longitude",
                      "expression": "`longitude`"
                    }
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 2,
              "mark": {
                "size": -2.2
              },
              "frame": {
                "showTitle": true,
                "title": "Emissions per locations"
              },
              "widgetType": "symbol-map",
